+// The largest committed stack the read covers before it gives up, which retains.
+constexpr size_t MAX_SCANNED_STACK_BYTES = size_t{64} << 20;
+
+// Reads the committed stack from `stack_pointer` to the top of its reservation for a return site. The addresses it
+// compares are formed only in this frame, so no caller's frame carries one and the current thread can be read from a
+// marker in its caller. A query failure, a non-readable page, or a stack past the bound reports a hit.
+[[nodiscard]] SAFETYHOOK_NOINLINE bool stack_holds_return_site(
+    uintptr_t stack_pointer, std::span<const ReturnSites* const> lists) noexcept {
+    constexpr DWORD readable = PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READ |
+                               PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
+    uintptr_t cursor = stack_pointer & ~static_cast<uintptr_t>(sizeof(uintptr_t) - 1);
+    MEMORY_BASIC_INFORMATION region{};
+    if (VirtualQuery(reinterpret_cast<const void*>(cursor), &region, sizeof(region)) != sizeof(region)) {
+        return true;
+    }
+    const void* const reservation = region.AllocationBase;
+    size_t scanned = 0;
+    for (;;) {
+        if (region.State != MEM_COMMIT || (region.Protect & readable) == 0 ||
+            (region.Protect & (PAGE_GUARD | PAGE_NOACCESS)) != 0) {
+            return true;
+        }
+        const auto region_end = reinterpret_cast<uintptr_t>(region.BaseAddress) + region.RegionSize;
+        for (; cursor + sizeof(uintptr_t) <= region_end; cursor += sizeof(uintptr_t)) {
+            scanned += sizeof(uintptr_t);
+            if (scanned > MAX_SCANNED_STACK_BYTES) {
+                return true;
+            }
+            const auto value = *reinterpret_cast<const uintptr_t*>(cursor);
+            for (const ReturnSites* list : lists) {
+                for (size_t i = 0; i < list->count; ++i) {
+                    if (value == reinterpret_cast<uintptr_t>(list->code + list->offsets[i])) {
+                        return true;
+                    }
+                }
+            }
+        }
+        if (VirtualQuery(reinterpret_cast<const void*>(cursor), &region, sizeof(region)) != sizeof(region) ||
+            region.AllocationBase != reservation) {
+            return false;
+        }
+    }
+}
