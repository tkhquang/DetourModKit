+
+bool RouteRetentionCredit::consume(RouteRetentionCost& reservation) noexcept {
+    if (!m_held) {
+        return false;
+    }
+    const RouteRetentionCost slot = route_worst_case();
+    if (m_remaining.logical < slot.logical || m_remaining.committed < slot.committed) {
+        return false;
+    }
+    m_remaining.logical -= slot.logical;
+    m_remaining.committed -= slot.committed;
+    reservation = slot;
+    return true;
+}
