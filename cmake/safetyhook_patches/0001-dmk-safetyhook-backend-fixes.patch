+// Opens every other thread of this process from one snapshot. A thread that exited after the snapshot was taken cannot
+// be inside any code range, so it is skipped. Every other failure leaves the set incomplete.
+[[nodiscard]] bool open_other_threads(HANDLE snapshot, ThreadHandleSet& handles) noexcept {
