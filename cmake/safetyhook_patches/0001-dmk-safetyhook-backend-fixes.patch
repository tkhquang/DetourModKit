+// A target whose first instruction is a call. The callee announces itself in flags[1], then waits for flags[0].
+[[nodiscard]] uint8_t* emit_call_first_target(Xbyak::CodeGenerator& cg, std::atomic<uint8_t>* flags) {
+    Xbyak::Label callee{};
+    Xbyak::Label spin{};
+    cg.call(callee);
+    cg.ret();
+    cg.L(callee);
+    cg.mov(rax, reinterpret_cast<uintptr_t>(flags));
+    cg.mov(byte[rax + 1], 1);
+    cg.L(spin);
+    cg.cmp(byte[rax], 0);
+    cg.je(spin);
+    cg.mov(eax, 7);
+    cg.ret();
+    return const_cast<uint8_t*>(cg.getCode());
+}
