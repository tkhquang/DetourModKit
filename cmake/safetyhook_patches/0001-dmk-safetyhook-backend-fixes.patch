+std::expected<void, InlineHook::Error> InlineHook::set_mid_route() {
+#if SAFETYHOOK_ARCH_X86_64
+    if (m_route_control == nullptr)
+        return {};
+    m_route_control->route_destination = m_route_control->detour_destination;
+    size_t count = 0;
+    const auto make_exit = [&](uint8_t* destination) -> uint8_t* {
+        if (count == MID_CONTINUATION_CAPACITY)
+            return nullptr;
+        auto* const entry = m_route_gateway.data() + MID_CONTINUATION_OFFSET + count++ * MID_CONTINUATION_SLOT;
+        store(entry + MID_CONTINUATION_DESTINATION_OFFSET, destination);
+        return entry;
+    };
+    auto* const fallthrough = make_exit(m_target + m_original_bytes.size());
+    auto* const epilogue = m_trampoline.data() + m_relocated_size;
+    const auto fallthrough_result =
+        m_type == Type::FF ? emit_jmp_ff(epilogue, fallthrough, epilogue + 6) : emit_jmp_e9(epilogue, fallthrough);
+    if (!fallthrough_result)
+        return fallthrough_result;
+    for (const auto& boundary : m_instruction_boundaries) {
+        auto* const original = m_target + boundary.original_offset;
+        ZydisDecodedInstruction instruction{};
+        if (!decode(&instruction, original))
+            return std::unexpected{Error::failed_to_decode_instruction(original)};
+        auto* const relocated = m_trampoline.data() + boundary.trampoline_offset;
+        const bool terminal =
+            instruction.meta.category == ZYDIS_CATEGORY_RET ||
+            (instruction.meta.category == ZYDIS_CATEGORY_UNCOND_BR && !instruction.raw.imm[0].is_relative);
+        if (terminal) {
+            auto* const exit = make_exit(nullptr);
+            if (exit == nullptr)
+                return std::unexpected{Error::not_enough_space(original)};
+            auto* const payload = exit + MID_CONTINUATION_DESTINATION_OFFSET + sizeof(uint8_t*);
+            std::copy_n(original, instruction.length, payload);
+            if (instruction.attributes & ZYDIS_ATTRIB_IS_RELATIVE) {
+                const auto destination = original + instruction.length + instruction.raw.disp.value;
+                const auto displacement = destination - (payload + instruction.length);
+                if (displacement < std::numeric_limits<int32_t>::min() ||
+                    displacement > std::numeric_limits<int32_t>::max())
+                    return std::unexpected{Error::ip_relative_instruction_out_of_range(original)};
+                store(payload + instruction.raw.disp.offset, static_cast<int32_t>(displacement));
+            }
+            store(exit + MID_CONTINUATION_DESTINATION_OFFSET, payload);
+            if (auto result = emit_jmp_e9(relocated, exit); !result)
+                return result;
+            continue;
+        }
+        if ((instruction.meta.category != ZYDIS_CATEGORY_COND_BR &&
+                instruction.meta.category != ZYDIS_CATEGORY_UNCOND_BR) ||
+            !instruction.raw.imm[0].is_relative)
+            continue;
+        auto* const destination = original + instruction.length + instruction.raw.imm[0].value.s;
+        if (destination >= m_target && destination < m_target + m_original_bytes.size())
+            continue;
+        auto* const exit = make_exit(destination);
+        if (exit == nullptr)
+            return std::unexpected{Error::not_enough_space(original)};
+        ZydisDecodedInstruction emitted{};
+        if (!decode(&emitted, relocated) || emitted.raw.imm[0].size != 32)
+            return std::unexpected{Error::unsupported_instruction_in_trampoline(original)};
+        const auto displacement = exit - (relocated + emitted.length);
+        if (displacement < std::numeric_limits<int32_t>::min() || displacement > std::numeric_limits<int32_t>::max())
+            return std::unexpected{Error::ip_relative_instruction_out_of_range(original)};
+        store(relocated + emitted.raw.imm[0].offset, static_cast<int32_t>(displacement));
     }
+    if (!vm_flush_instruction_cache(m_trampoline.data(), m_trampoline.size()) ||
+        !vm_flush_instruction_cache(m_route_gateway.data(), m_route_gateway.size()))
+        return std::unexpected{Error::failed_to_flush_instruction_cache(m_trampoline.data())};
+#endif
+    return {};
+}
 
