+                throw std::bad_alloc{};
+            }
+        }
+#endif
+    } catch (...) {
+        run_error = std::current_exception();
+    }
+
+    DWORD ignored{};
+    const auto restored_to = VirtualProtect(to, len, to_protect, &ignored) != FALSE;
+    const auto restored_from = VirtualProtect(from, len, from_protect, &ignored) != FALSE;
+    remove_trap();
 
-    if (run_fn) {
-        run_fn();
+    if (run_error) {
+        std::rethrow_exception(run_error);
+    }
+
+#if defined(SAFETYHOOK_ENABLE_TEST_SEAMS)
+    // A reprotection failure that lands after run_fn has already committed its write is the one transaction outcome a
+    // host cannot provoke on demand, and it is exactly the state a caller's logical enabled flag has to survive. The
+    // seam reports that outcome without disturbing the page: the traps are removed and the protections really were
+    // restored above. Arming by address keeps an armed seam from perturbing unrelated hooks in the same process.
+    if (const auto* armed = g_trap_restore_failure_override.load(std::memory_order_acquire);
+        armed != nullptr && (armed == from || armed == to)) {
+        return std::unexpected{OsError::FAILED_TO_PROTECT};
+    }
+#endif
+
+    if (!restored_to || !restored_from) {
+        return std::unexpected{OsError::FAILED_TO_PROTECT};
     }
 
-    VirtualProtect(to, len, to_protect, &to_protect);
-    VirtualProtect(from, len, from_protect, &from_protect);
+    return {};
 }
 
