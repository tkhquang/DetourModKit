+TEST(InlineHook, ThreadsIdleOutsideSeesAThreadParkedInsideARange) {
+    // A spin loop in a private executable page: it announces itself, then waits for its release byte.
+    static std::atomic<uint8_t> flags[2]{};
+    flags[0].store(0, std::memory_order_relaxed);
+    flags[1].store(0, std::memory_order_relaxed);
+    Xbyak::CodeGenerator cg{};
+    Xbyak::Label spin{};
+    cg.mov(rax, reinterpret_cast<uintptr_t>(&flags[0]));
+    cg.mov(byte[rax + 1], 1);
+    cg.L(spin);
+    cg.cmp(byte[rax], 0);
+    cg.je(spin);
+    cg.ret();
+    auto* const code = const_cast<uint8_t*>(cg.getCode());
+    const safetyhook::AddressRange parked{code, code + cg.getSize()};
+
+    std::thread helper{cg.getCode<void (*)()>()};
+    while (flags[1].load(std::memory_order_acquire) == 0) {
+        std::this_thread::yield();
+    }
+
+    const auto inside = safetyhook::threads_idle_outside(std::span<const safetyhook::AddressRange>{&parked, 1}, {});
+    ASSERT_TRUE(inside.has_value());
+    EXPECT_FALSE(*inside);
+
+    // The current thread is skipped: this image holds its own frames, and the helper sits outside it.
+    const safetyhook::AddressRange image = image_range();
+    const auto outside = safetyhook::threads_idle_outside(std::span<const safetyhook::AddressRange>{&image, 1}, {});
+    ASSERT_TRUE(outside.has_value());
+    EXPECT_TRUE(*outside);
+
+    flags[0].store(1, std::memory_order_release);
+    helper.join();
+}
