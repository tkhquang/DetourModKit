+    if (allocation.size() > std::numeric_limits<size_t>::max() - m_route_retention.logical ||
+        allocation.backing_size() > std::numeric_limits<size_t>::max() - m_route_retention.committed) {
+        return false;
+    }
+    const RouteRetentionCost combined{
+        m_route_retention.logical + allocation.size(), m_route_retention.committed + allocation.backing_size()};
+    if (combined.logical > m_route_reservation.logical || combined.committed > m_route_reservation.committed) {
+        return false;
+    }
+    m_route_retention = combined;
+    return true;
