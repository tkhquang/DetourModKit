+#if SAFETYHOOK_ARCH_X86_64
+bool InlineHook::reclaim_published_route() noexcept {
+    // The route is closed by now, but only a restored target proves that nothing can enter it again.
+    if (m_enabled || m_route_control->entries.load(std::memory_order_seq_cst) != 0) {
+        return false;
+    }
+    std::array<AddressRange, 2 + 2 * RETAINED_ROUTE_CAPACITY> ranges{};
+    size_t range_count = 0;
+    ranges[range_count++] = AddressRange{m_route_gateway.data(), m_route_gateway.data() + m_route_gateway.size()};
+    ranges[range_count++] = AddressRange{m_trampoline.data(), m_trampoline.data() + m_trampoline.size()};
+    // Pointers into gateways and the registry, never the return addresses themselves.
+    std::array<const ReturnSites*, 1 + RETAINED_ROUTE_CAPACITY> return_sites{};
+    size_t list_count = 0;
+    return_sites[list_count++] = &m_route_control->return_sites;
+    {
+        const RouteRetentionGuard guard;
+        if (g_retained_routes.overflowed) {
+            return false;
+        }
+        for (size_t i = 0; i < g_retained_routes.count; ++i) {
+            const RetainedRouteRecord& record = g_retained_routes.records[i];
+            if (record.target != m_target) {
+                continue;
+            }
+            // A retained chain admits nobody once its target is restored, so a zero read here stays zero.
+            if (record.entries->load(std::memory_order_seq_cst) != 0) {
+                return false;
+            }
+            ranges[range_count++] = record.gateway;
+            ranges[range_count++] = record.trampoline;
+            return_sites[list_count++] = record.return_sites;
+        }
+    }
+    const auto idle = threads_idle_outside(std::span<const AddressRange>{ranges.data(), range_count},
+        std::span<const ReturnSites* const>{return_sites.data(), list_count});
+    if (!idle.has_value() || !*idle) {
+        return false;
+    }
+    // Records are withdrawn only after the proof and before the storage that holds them is freed. A refusal keeps the
+    // chain exactly as a failed proof does.
+    if (m_route_unwind_table != nullptr && !vm_unregister_unwind_table(m_route_unwind_table)) {
+        return false;
+    }
+    if (m_route_retention_charged) {
+        refund_route_chain(m_route_retention);
+    } else {
+        release_route_chain(m_route_reservation);
+    }
+    m_route_control->~RouteControl();
+    m_route_gateway.free();
     m_trampoline.free();
+    return true;
+}
+
+void InlineHook::register_retained_route() noexcept {
+    const RouteRetentionGuard guard;
+    if (g_retained_routes.count == g_retained_routes.records.size()) {
+        g_retained_routes.overflowed = true;
+        return;
+    }
+    g_retained_routes.records[g_retained_routes.count++] = RetainedRouteRecord{
+        m_target,
+        AddressRange{m_route_gateway.data(), m_route_gateway.data() + m_route_gateway.size()},
+        AddressRange{m_trampoline.data(), m_trampoline.data() + m_trampoline.size()},
+        &m_route_control->entries,
+        &m_route_control->return_sites,
+    };
+}
+#else
+bool InlineHook::reclaim_published_route() noexcept {
+    return false;
+}
+
+void InlineHook::register_retained_route() noexcept {
+}
+#endif
+
+void InlineHook::destroy() noexcept {
+    try {
+        (void)disable();
+    } catch (...) {
+        m_enabled ? cancel_route_rundown() : finish_route_rundown();
+    }
+
+    std::unique_lock lock{m_mutex, std::defer_lock};
+    try {
+#if defined(SAFETYHOOK_ENABLE_TEST_SEAMS)
+        auto* expected = m_target;
+        if (expected != nullptr && g_destroy_lock_failure_target.compare_exchange_strong(expected, nullptr)) {
+            throw std::system_error{std::make_error_code(std::errc::resource_unavailable_try_again)};
+        }
+#endif
+        lock.lock();
+    } catch (...) {
+        if (m_route_control != nullptr) {
+            if (!m_route_retention_charged) {
+                charge_route_chain(m_route_retention, m_route_reservation);
+                m_route_reservation = {};
+                m_route_retention_charged = true;
+            }
+            register_retained_route();
+            m_trampoline.abandon();
+            m_route_gateway.abandon();
+            m_route_retained = true;
+            m_route_unwind_table = nullptr;
+            m_route_control = nullptr;
+        }
+        return;
+    }
+    m_route_retained = false;
+
+    if (m_route_control != nullptr) {
+        if (m_route_published) {
+            // A caller can sit before the gateway's entry increment or after an exit decrement, where the entry
+            // counter does not cover it. Every such thread has its instruction pointer inside the gateway or the
+            // trampoline, or a return address into the trampoline from a relocated call, and nothing can enter
+            // either once the target is restored, so an idle proof over those ranges and return sites decides
+            // whether the chain is freed or kept, records included, mapped for the process lifetime.
+            finish_route_rundown();
+            if (!reclaim_published_route()) {
+                if (!m_route_retention_charged) {
+                    charge_route_chain(m_route_retention, m_route_reservation);
+                    m_route_reservation = {};
+                    m_route_retention_charged = true;
+                }
+                register_retained_route();
+                m_trampoline.abandon();
+                m_route_gateway.abandon();
+                m_route_retained = true;
+            }
+        } else {
+            // Nothing ever reached this code, so the records can be withdrawn before the storage holding them goes
+            // back to the allocator. Order matters: freeing first would leave the platform pointing at reusable memory.
+            if (m_route_unwind_table != nullptr && !vm_unregister_unwind_table(m_route_unwind_table)) {
+                // The OS still owns a pointer into the gateway. Retain its entire arena and account it permanently;
+                // freeing either allocation would turn a platform metadata lookup into a use-after-free.
+                if (m_route_retention.logical == 0 && m_route_retention.committed == 0) {
+                    m_route_retention = route_retention_cost();
+                }
+                charge_route_chain(m_route_retention, m_route_reservation);
+                m_route_reservation = {};
+                m_route_retention_charged = true;
+                m_trampoline.abandon();
+                m_route_gateway.abandon();
+                m_route_retained = true;
+                m_route_unwind_table = nullptr;
+                m_route_retention = {};
+                m_route_control = nullptr;
+                return;
+            }
+            release_route_chain(m_route_reservation);
+            m_route_control->~RouteControl();
+            m_route_gateway.free();
+            m_trampoline.free();
+        }
+        m_route_unwind_table = nullptr;
+        m_route_retention = {};
+        m_route_reservation = {};
+        m_route_retention_charged = false;
+        m_route_control = nullptr;
+        return;
+    }
+
+    if (m_trampoline) {
+        m_trampoline.free();
+    }
 }
