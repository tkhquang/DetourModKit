+class TrapShutdown final {
+public:
+    explicit TrapShutdown(TrapRuntime* runtime) noexcept : m_runtime{runtime} {}
+    ~TrapShutdown() { shut_down_trap_runtime(m_runtime); }
+
+    TrapShutdown(const TrapShutdown&) = delete;
+    TrapShutdown& operator=(const TrapShutdown&) = delete;
+
+private:
+    TrapRuntime* m_runtime;
+};
+
+[[nodiscard]] static TrapRuntime* trap_runtime() noexcept {
+    static TrapRuntime* const runtime = new (std::nothrow) TrapRuntime{};
+    static TrapShutdown shutdown{runtime};
+    return runtime;
+}
+
+static void shut_down_trap_runtime(TrapRuntime* runtime) noexcept {
+    if (runtime == nullptr) {
+        return;
+    }
+
+    const SrwExclusiveGuard transaction_guard{runtime->transaction_lock};
+    if (runtime->transactions_closed) {
+        return;
+    }
+    runtime->transactions_closed = true;
+
+    constexpr uint64_t closed_bit = uint64_t{1} << 63;
+    if (runtime->gateway_data != nullptr) {
+        runtime->gateway_data->admission.fetch_or(closed_bit, std::memory_order_seq_cst);
+    }
+    if (runtime->vectored_handle != nullptr) {
+        (void)RemoveVectoredExceptionHandler(runtime->vectored_handle);
+        runtime->vectored_handle = nullptr;
+    }
+    if (runtime->gateway_data != nullptr) {
+        while ((runtime->gateway_data->admission.load(std::memory_order_seq_cst) & ~closed_bit) != 0) {
+            SwitchToThread();
+        }
+    }
+
+    const SrwExclusiveGuard trap_guard{runtime->trap_lock};
+    delete runtime->manager;
+    runtime->manager = nullptr;
+    // The gateway and its data page stay mapped: a callback selected before removal may not yet have executed its
+    // first instruction. Its closed branch contains the exact committed-executable DEP retry and names no module code.
+}
 
